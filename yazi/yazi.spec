# Rust dependencies are vendored (see sources.sh), so the build runs offline
# as it would in COPR or mock.

Name:           yazi
Version:        26.9.1
Release:        1%{?dist}
Summary:        Terminal file manager based on async I/O

# Yazi itself is MIT, and so are its bundled icons (LICENSE-ICONS). The rest
# covers the bundled crates, as printed by %%cargo_license_summary in the build
# log, plus BSD-2-Clause for jemalloc, which tikv-jemalloc-sys builds in;
# update it when bumping the version.
SourceLicense:  MIT
License:        MIT AND Apache-2.0 AND BSD-2-Clause AND BSD-3-Clause AND BSL-1.0 AND BlueOak-1.0.0 AND CC0-1.0 AND CDLA-Permissive-2.0 AND ISC AND MPL-2.0 AND Unicode-3.0 AND Zlib AND (Apache-2.0 OR MIT) AND (0BSD OR MIT OR Apache-2.0) AND (Apache-2.0 OR ISC OR MIT) AND (Apache-2.0 WITH LLVM-exception OR Apache-2.0 OR MIT) AND (BSD-2-Clause OR Apache-2.0 OR MIT) AND (BSD-3-Clause OR Apache-2.0) AND (MIT OR Apache-2.0 OR BSD-1-Clause) AND (MIT OR Apache-2.0 OR LGPL-2.1-or-later) AND (MIT OR Zlib OR Apache-2.0) AND (Unlicense OR MIT)
URL:            https://github.com/sxyazi/yazi
Source0:        https://github.com/sxyazi/yazi/archive/v%{version}/%{name}-%{version}.tar.gz
# Generated by sources.sh: `cargo vendor` of the tarball's Cargo.lock, with
# the cargo source stanzas for its git dependencies
Source1:        %{name}-%{version}-vendor.tar.xz
# Launches yazi in foot, replacing upstream's Terminal=true entry
Source2:        yazi.desktop

ExclusiveArch:  %{rust_arches}

BuildRequires:  cargo-rpm-macros >= 26
BuildRequires:  gcc
BuildRequires:  pkgconfig(oniguruma)
# See %%prep: upstream targets Lua 5.5, built against the system 5.4 here
BuildRequires:  pkgconfig(lua) >= 5.4
BuildRequires:  desktop-file-utils

# Used by the desktop entry
Requires:       foot
Requires:       google-droid-sans-mono-fonts
# Yazi detects MIME types with file(1)
Requires:       file
# Previews, search and clipboard; each feature is skipped when its tool is
# missing
Recommends:     /usr/bin/ffmpeg
Recommends:     7zip
Recommends:     jq
Recommends:     poppler-utils
Recommends:     fd-find
Recommends:     ripgrep
Recommends:     fzf
Recommends:     zoxide
Recommends:     resvg
Recommends:     ImageMagick
Recommends:     chafa
Recommends:     wl-clipboard

%description
Yazi is a terminal file manager written in Rust, based on non-blocking async
I/O. It has image previews, a Lua plugin system, bulk renaming, tabs and
integration with tools such as fd, ripgrep, fzf and zoxide. The ya command
manages plugins and flavors and talks to running instances.

%prep
%autosetup -n %{name}-%{version} -a1
%cargo_prep -v vendor
# Upstream patches ratatui-core from a git branch, which is vendored too
cat vendor-git-sources.toml >> .cargo/config.toml

# Link the system Lua 5.4 rather than a bundled Lua 5.5, which Fedora does not
# ship. The only 5.5 API yazi uses is external strings, which hand a Rust
# buffer to Lua without copying; create_string copies it instead, with the
# same result. Done with sed rather than a patch so that it keeps up with new
# call sites in upstream releases; the checks fail the build if upstream's
# layout changes.
sed -i 's/"lua55"/"lua54"/' Cargo.toml
grep -q '"lua54"' Cargo.toml
grep -rlZ --include='*.rs' create_external_string yazi-*/ |
    xargs -0 -r sed -i 's/\bcreate_external_string(/create_string(/g'
if grep -rq --include='*.rs' create_external_string yazi-*/; then exit 1; fi
# Each crate that uses mlua turns on its bundled Lua by default
sed -i -E 's/^(default[[:space:]]*=[[:space:]]*)\[ "vendored-lua" \]/\1[]/' yazi-*/Cargo.toml
if grep -q '^default.*vendored-lua' yazi-*/Cargo.toml; then exit 1; fi

%build
# Shell completions are written to yazi-boot/completions and
# yazi-cli/completions by the build scripts. The version string would
# otherwise try to read a commit hash from git. Oniguruma (for syntect) is
# linked from the system, as is Lua (see %%prep).
export YAZI_GEN_COMPLETIONS=1
export YAZI_NO_GITCL=1
export RUSTONIG_SYSTEM_LIBONIG=1
%cargo_build
%{cargo_license_summary}
%{cargo_license} > LICENSE.dependencies
%cargo_vendor_manifest

%install
install -Dpm 0755 target/rpm/yazi %{buildroot}%{_bindir}/yazi
install -Dpm 0755 target/rpm/ya %{buildroot}%{_bindir}/ya
for bin in yazi ya; do
    dir=yazi-boot/completions
    [ $bin = ya ] && dir=yazi-cli/completions
    install -Dpm 0644 $dir/$bin.bash %{buildroot}%{bash_completions_dir}/$bin
    install -Dpm 0644 $dir/$bin.fish %{buildroot}%{fish_completions_dir}/$bin.fish
    install -Dpm 0644 $dir/_$bin %{buildroot}%{zsh_completions_dir}/_$bin
done
# Not square, so not a hicolor size
install -Dpm 0644 assets/logo.png %{buildroot}%{_datadir}/pixmaps/yazi.png
desktop-file-install --dir=%{buildroot}%{_datadir}/applications %{SOURCE2}

%check
desktop-file-validate %{buildroot}%{_datadir}/applications/yazi.desktop
%{buildroot}%{_bindir}/yazi --version
%{buildroot}%{_bindir}/ya --version

%files
%license LICENSE LICENSE-ICONS LICENSE.dependencies cargo-vendor.txt
%doc README.md CHANGELOG.md
%{_bindir}/yazi
%{_bindir}/ya
%{bash_completions_dir}/yazi
%{bash_completions_dir}/ya
%{fish_completions_dir}/yazi.fish
%{fish_completions_dir}/ya.fish
%{zsh_completions_dir}/_yazi
%{zsh_completions_dir}/_ya
%{_datadir}/applications/yazi.desktop
%{_datadir}/pixmaps/yazi.png

