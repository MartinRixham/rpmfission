# The tag's tarball has none of upstream's git submodules. Linux needs three
# of them, downloaded at the commits the tag pins (`git ls-tree v<version>
# 3rdparty/` in upstream's repository; update them with the version). c-ares
# is Fedora's instead, and Sentry (crash reports) is not built. Rust crates
# are vendored by sources.sh, so the build runs offline as it would in COPR
# or mock. The Go netfilter library builds against Fedora's Go packages, but
# for nftables, which Fedora does not package: use the version in
# linux/netfilter/go.mod.
%global boringtun_commit 9a60fd21f4455b657cd27a63a491613e1bae36af
%global wgtools_commit   139aac59a5ab7da913d4b6dd62692fa90e2ccad4
%global i18n_commit      9cf4001dea46348453fc95971e37e6e3797c1501
%global nftables_version 0.1.0

Name:           mozilla-vpn
Version:        2.40.1
Release:        2%{?dist}
Summary:        Mozilla VPN client

# Mozilla VPN itself is MPL-2.0, its Lottie player MIT, and its Inter and
# Metropolis fonts OFL-1.1. WireGuard's embeddable library is
# LGPL-2.1-or-later. The rest covers the bundled crates, as printed by
# %%cargo_license_summary in the build log (its blank entry is upstream's
# obfuscators and signature crates, MPL-2.0 with no license field), and the
# Go packages linked into the netfilter library: nftables (Apache-2.0),
# Fedora's netlink, socket and native (MIT) and x/sys (BSD-3-Clause); update
# it when bumping the version.
SourceLicense:  MPL-2.0 AND MIT AND OFL-1.1 AND LGPL-2.1-or-later AND Apache-2.0
License:        MPL-2.0 AND MIT AND OFL-1.1 AND LGPL-2.1-or-later AND Apache-2.0 AND BSD-2-Clause AND BSD-3-Clause AND ISC AND (Apache-2.0 OR MIT) AND (Apache-2.0 WITH LLVM-exception OR Apache-2.0 OR MIT) AND (BSD-2-Clause OR Apache-2.0 OR MIT) AND (MIT OR Apache-2.0 OR BSD-1-Clause) AND (Unlicense OR MIT)
URL:            https://github.com/mozilla-mobile/mozilla-vpn-client
Source0:        %{url}/archive/v%{version}/mozilla-vpn-client-%{version}.tar.gz
Source1:        https://github.com/cloudflare/boringtun/archive/%{boringtun_commit}/boringtun-%{boringtun_commit}.tar.gz
Source2:        https://github.com/WireGuard/wireguard-tools/archive/%{wgtools_commit}/wireguard-tools-%{wgtools_commit}.tar.gz
Source3:        https://github.com/mozilla-l10n/mozilla-vpn-client-l10n/archive/%{i18n_commit}/mozilla-vpn-client-l10n-%{i18n_commit}.tar.gz
# Generated by sources.sh: `cargo vendor` of the tarball's Cargo.lock, with
# the cargo source stanzas for its git dependencies
Source4:        %{name}-%{version}-vendor.tar.xz
Source5:        https://github.com/google/nftables/archive/v%{nftables_version}/nftables-%{nftables_version}.tar.gz

# Rust and Go both
ExclusiveArch:  %{rust_arches}

BuildRequires:  cargo-rpm-macros >= 26
BuildRequires:  cmake
BuildRequires:  ninja-build
BuildRequires:  gcc
BuildRequires:  gcc-c++
BuildRequires:  golang
BuildRequires:  go-rpm-macros
BuildRequires:  golang(github.com/mdlayher/netlink)
BuildRequires:  golang(golang.org/x/sys/unix)
BuildRequires:  python3
BuildRequires:  python3-pyyaml
BuildRequires:  systemd-rpm-macros
BuildRequires:  desktop-file-utils
BuildRequires:  appstream
BuildRequires:  pkgconfig(libcares)
BuildRequires:  pkgconfig(polkit-gobject-1)
BuildRequires:  pkgconfig(systemd)
BuildRequires:  cmake(Qt6Core) >= 6.9
BuildRequires:  cmake(Qt6DBus)
BuildRequires:  cmake(Qt6Gui)
BuildRequires:  cmake(Qt6GuiPrivate)
BuildRequires:  cmake(Qt6Network)
BuildRequires:  cmake(Qt6NetworkAuth)
BuildRequires:  cmake(Qt6Qml)
BuildRequires:  cmake(Qt6QmlPrivate)
BuildRequires:  cmake(Qt6Quick)
BuildRequires:  cmake(Qt6QuickControls2)
BuildRequires:  cmake(Qt6QuickTest)
BuildRequires:  cmake(Qt6Svg)
BuildRequires:  cmake(Qt6Test)
BuildRequires:  cmake(Qt6WebSockets)
BuildRequires:  cmake(Qt6Widgets)
BuildRequires:  cmake(Qt6Xml)
BuildRequires:  qt6-linguist

# The QML modules the interface imports, and the SVG image plugin for its
# icons; neither is linked
Requires:       qt6-qtdeclarative%{?_isa}
Requires:       qt6-qtsvg%{?_isa}
# The daemon is authorised through polkit, and split tunnelling marks
# packets with xt_cgroup (see the service's modprobe@xt_cgroup)
Requires:       polkit
# Owns %%{_libdir}/mozilla/native-messaging-hosts, the only system directory
# Fedora's Firefox reads manifests from on 64-bit (not /usr/lib)
Requires:       mozilla-filesystem
%{?systemd_requires}
# Mozilla's own package
Conflicts:      mozillavpn

%description
Mozilla VPN is the client for Mozilla's WireGuard VPN service, which needs a
subscription. It routes all traffic, or all but chosen applications, through
servers in a choice of countries, and can block ads and trackers through its
DNS. A daemon, mozillavpn.service, sets up the WireGuard interface and the
firewall for the unprivileged interface. The socksproxy service lets the
Mozilla VPN browser extension exclude websites from the VPN.

%prep
%autosetup -n mozilla-vpn-client-%{version} -a4
for dir in boringtun wireguard-tools i18n; do
    rmdir 3rdparty/$dir
done
tar -xzf %{SOURCE1} -C 3rdparty
mv 3rdparty/boringtun-%{boringtun_commit} 3rdparty/boringtun
tar -xzf %{SOURCE2} -C 3rdparty
mv 3rdparty/wireguard-tools-%{wgtools_commit} 3rdparty/wireguard-tools
tar -xzf %{SOURCE3} -C 3rdparty
mv 3rdparty/mozilla-vpn-client-l10n-%{i18n_commit} 3rdparty/i18n
# nftables goes in a GOPATH of its own, ahead of Fedora's (see %%build)
mkdir -p _gopath/src/github.com/google
tar -xzf %{SOURCE5} -C _gopath/src/github.com/google
mv _gopath/src/github.com/google/nftables-%{nftables_version} \
    _gopath/src/github.com/google/nftables
%cargo_prep -v vendor
cat vendor-git-sources.toml >> .cargo/config.toml

# Link Fedora's c-ares rather than build the submodule. The socks proxy
# library links and depends on a target named c-ares.
cat > 3rdparty/c-ares.cmake <<'EOF'
find_package(PkgConfig REQUIRED)
pkg_check_modules(libcares REQUIRED IMPORTED_TARGET libcares)
add_library(c-ares INTERFACE)
target_link_libraries(c-ares INTERFACE PkgConfig::libcares)
EOF

%build
# Build netfilter in GOPATH mode, from nftables and Fedora's Go packages,
# rather than the module versions in its go.mod, which would be downloaded.
# cmake passes the environment on to go build.
export GO111MODULE=off
export GOPATH=$PWD/_gopath:%{gopath}
# BUILD_ID would otherwise be the time of the build, as there is no .git
%cmake -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_TESTS=OFF \
    -DBUILD_TESTING=OFF \
    -DBUILD_CRASHREPORTING=OFF \
    -DBUILD_ID=%{version} \
    -DCMAKE_INSTALL_SYSCONFDIR=%{_sysconfdir}
%cmake_build
%{cargo_license_summary}
%{cargo_license} > LICENSE.dependencies
%cargo_vendor_manifest

%install
%cmake_install

%check
desktop-file-validate %{buildroot}%{_datadir}/applications/org.mozilla.vpn.desktop
appstreamcli validate --no-net %{buildroot}%{_metainfodir}/org.mozilla.vpn.metainfo.xml
QT_QPA_PLATFORM=offscreen %{buildroot}%{_bindir}/mozillavpn --version

%post
%systemd_post mozillavpn.service socksproxy.service

%preun
%systemd_preun mozillavpn.service socksproxy.service

%postun
%systemd_postun_with_restart mozillavpn.service socksproxy.service

%files
%license LICENSE.md LICENSE.dependencies cargo-vendor.txt
%doc README.md
%{_bindir}/mozillavpn
%{_bindir}/mozillavpn-obfuscator
%{_bindir}/socksproxy
%{_unitdir}/mozillavpn.service
%{_unitdir}/socksproxy.service
%{_datadir}/applications/org.mozilla.vpn.desktop
%{_datadir}/dbus-1/system-services/org.mozilla.vpn.dbus.service
%{_datadir}/dbus-1/system.d/org.mozilla.vpn.conf
%{_datadir}/icons/hicolor/*/apps/org.mozilla.vpn.*
%{_metainfodir}/org.mozilla.vpn.metainfo.xml
%{_metainfodir}/org.mozilla.vpn.releases.xml
%{_datadir}/polkit-1/actions/org.mozilla.vpn.policy
%{_datadir}/polkit-1/rules.d/org.mozilla.vpn.rules
# Native messaging manifests for the browser extension
%{_libdir}/mozilla/native-messaging-hosts/mozillavpn.json
%dir %{_sysconfdir}/chromium
%dir %{_sysconfdir}/chromium/native-messaging-hosts
%config(noreplace) %{_sysconfdir}/chromium/native-messaging-hosts/mozillavpn.json
%dir %{_sysconfdir}/opt/chrome
%dir %{_sysconfdir}/opt/chrome/native-messaging-hosts
%config(noreplace) %{_sysconfdir}/opt/chrome/native-messaging-hosts/mozillavpn.json

