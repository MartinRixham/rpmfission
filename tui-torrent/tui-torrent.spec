# Rust dependencies are vendored (see sources.sh), so the build runs offline
# as it would in COPR or mock.

Name:           tui-torrent
Version:        1.1.0
Release:        2%{?dist}
Summary:        Terminal user interface for searching and downloading torrents

# tui-torrent itself is MIT. The rest covers the bundled crates, as printed by
# %%cargo_license_summary in the build log; update it when bumping the version.
SourceLicense:  MIT
License:        MIT AND Apache-2.0 AND BSD-3-Clause AND ISC AND MPL-2.0 AND Unicode-3.0 AND Zlib AND (Apache-2.0 OR MIT) AND (0BSD OR MIT OR Apache-2.0) AND (Apache-2.0 OR BSL-1.0) AND (Apache-2.0 OR ISC OR MIT) AND (Apache-2.0 WITH LLVM-exception OR Apache-2.0 OR MIT) AND (BSD-2-Clause OR Apache-2.0 OR MIT) AND (MIT OR Apache-2.0 OR LGPL-2.1-or-later) AND (MIT OR Zlib OR Apache-2.0) AND (Unlicense OR MIT)
URL:            https://github.com/QuintenWiggill/tui-torrent
# Upstream has no release tags; the crates.io crate is the release artifact
# and, unlike the repository, pins its dependencies with a Cargo.lock
Source0:        https://static.crates.io/crates/%{name}/%{name}-%{version}.crate
# Generated by sources.sh: `cargo vendor` of the crate's Cargo.lock
Source1:        %{name}-%{version}-vendor.tar.xz
# Upstream starts aria2c with RPC on all interfaces, open to any web origin
# and with no secret, so other hosts and any web page can drive it and write
# files as the user. Start it on loopback only, on a free port rather than
# 6800, with a secret token generated per run and kept off the command line.
# Same patch as cervino's
# extra/tui-torrent/aria2-rpc-secret.patch; keep the two in sync.
Patch0:         tui-torrent-aria2-rpc-secret.patch

ExclusiveArch:  %{rust_arches}

BuildRequires:  cargo-rpm-macros >= 26
BuildRequires:  pkgconfig(openssl)

# Downloads go through aria2's RPC interface; tui-torrent starts aria2c
# itself when it is not already running
Requires:       aria2

%description
tui-torrent is a terminal user interface for searching torrents on several
sources concurrently and downloading them with aria2, with play/pause control
of running downloads.

%prep
%autosetup -n %{name}-%{version} -p1 -a1
%cargo_prep -v vendor

%build
%cargo_build
%{cargo_license_summary}
%{cargo_license} > LICENSE.dependencies
%cargo_vendor_manifest

%install
install -Dpm 0755 target/rpm/tui-torrent %{buildroot}%{_bindir}/tui-torrent

%check
# search_test queries the live torrent sites and needs the network
%cargo_test -- --lib --test app_tests --test utils_tests

%files
%license LICENSE LICENSE.dependencies cargo-vendor.txt
%doc README.md
%{_bindir}/tui-torrent

%changelog
