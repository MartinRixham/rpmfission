+find_package(pybind11 CONFIG REQUIRED)
+find_package(whisper CONFIG REQUIRED)
 
 pybind11_add_module(_pywhispercpp
 	src/main.cpp
@@ -10,3 +12,5 @@
 
 target_link_libraries (_pywhispercpp PRIVATE whisper)
 
+# libwhisper may be outside the linker's search path
+set_target_properties(_pywhispercpp PROPERTIES INSTALL_RPATH "${WHISPER_LIB_DIR}")
