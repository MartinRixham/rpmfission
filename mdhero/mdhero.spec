# Rust crates and the frontend's node_modules are vendored (see sources.sh),
# so the build runs offline as it would in COPR or mock.

Name:           mdhero
Version:        0.2.10
Release:        1%{?dist}
Summary:        Markdown viewer and lightweight editor

# mdhero itself is MIT. The rest covers the bundled crates, as printed by
# %%cargo_license_summary in the build log, and the JavaScript bundled into
# the frontend; update it when bumping the version.
SourceLicense:  MIT
License:        MIT
URL:            https://github.com/vaibhav-kakde-in/mdhero
Source0:        %{url}/archive/v%{version}/%{name}-%{version}.tar.gz
# Generated by sources.sh: `cargo vendor` of src-tauri/Cargo.lock
Source1:        %{name}-%{version}-vendor.tar.xz
# Generated by sources.sh: `pnpm install` of pnpm-lock.yaml, with the native
# packages of both architectures
Source2:        %{name}-%{version}-node_modules.tar.xz
Source3:        %{name}.desktop
# Upstream checks mdhero.app and GitHub for a newer release and offers to
# download and install upstream's own package over this one. dnf updates it
# here, so drop the check, its menu item and the updater plugin.
Patch0:         %{name}-no-updater.patch

# node_modules carries the native build tools for these two only
ExclusiveArch:  x86_64 aarch64

BuildRequires:  cargo-rpm-macros >= 26
BuildRequires:  nodejs >= 22
BuildRequires:  desktop-file-utils
BuildRequires:  pkgconfig(gtk+-3.0)
BuildRequires:  pkgconfig(javascriptcoregtk-4.1)
BuildRequires:  pkgconfig(libsoup-3.0)
BuildRequires:  pkgconfig(openssl)
BuildRequires:  pkgconfig(webkit2gtk-4.1)

Requires:       hicolor-icon-theme

%description
MDHero is a native Markdown viewer and lightweight editor. It renders local
files, pasted Markdown and public URLs with syntax highlighting, KaTeX math
and Mermaid diagrams, with tabs, a table of contents, search, vim keys and
live reload of files changed by other editors.

%prep
%autosetup -n %{name}-%{version} -p1 -a2
cd src-tauri
tar -xJf %{SOURCE1}
%cargo_prep -v vendor

%build
# pnpm build: the SvelteKit frontend, into build/
node node_modules/vite/bin/vite.js build
cd src-tauri
# The Tauri CLI adds tauri/custom-protocol to serve the built frontend from
# the binary, rather than from the dev server
%cargo_build -f tauri/custom-protocol
%{cargo_license_summary -f tauri/custom-protocol}
%{cargo_license -f tauri/custom-protocol} > LICENSE.dependencies
%cargo_vendor_manifest

%install
install -Dpm 0755 src-tauri/target/rpm/%{name} %{buildroot}%{_bindir}/%{name}
desktop-file-install --dir=%{buildroot}%{_datadir}/applications %{SOURCE3}
for size in 32 64 128; do
    install -Dpm 0644 src-tauri/icons/${size}x${size}.png \
        %{buildroot}%{_datadir}/icons/hicolor/${size}x${size}/apps/%{name}.png
done
install -Dpm 0644 src-tauri/icons/128x128@2x.png \
    %{buildroot}%{_datadir}/icons/hicolor/256x256/apps/%{name}.png
install -Dpm 0644 src-tauri/icons/icon.png \
    %{buildroot}%{_datadir}/icons/hicolor/512x512/apps/%{name}.png

%check
desktop-file-validate %{buildroot}%{_datadir}/applications/%{name}.desktop
# pnpm test
node node_modules/vitest/vitest.mjs run
cd src-tauri
# menu_window needs a display
%cargo_test -f tauri/custom-protocol -- --lib

%files
%license LICENSE src-tauri/LICENSE.dependencies src-tauri/cargo-vendor.txt
%doc README.md
%{_bindir}/%{name}
%{_datadir}/applications/%{name}.desktop
%{_datadir}/icons/hicolor/*/apps/%{name}.png

