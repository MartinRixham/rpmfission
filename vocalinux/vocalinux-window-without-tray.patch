+    def _init_window(self) -> None:
+        """Show the tray menu, status and a start/stop button in a window.
+
+        Used where there is no tray host, as on GNOME without the AppIndicator
+        extension. Closing the window quits, as there is no other way back in.
+        """
+        window = Gtk.Window(title="Vocalinux")
+        window.set_icon_name("vocalinux")
+        window.set_default_size(360, -1)
+        window.set_resizable(False)
+        window.connect("delete-event", self._on_window_delete)
+
+        header = Gtk.HeaderBar(title="Vocalinux", show_close_button=True)
+        menu_button = Gtk.MenuButton(
+            image=Gtk.Image.new_from_icon_name("open-menu-symbolic", Gtk.IconSize.BUTTON),
+            tooltip_text="Menu",
+        )
+        menu_button.set_popup(self.menu)
+        header.pack_end(menu_button)
+        window.set_titlebar(header)
+
+        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
+        box.set_border_width(24)
+        self._window_image = Gtk.Image()
+        box.pack_start(self._window_image, False, False, 0)
+        self._window_status = Gtk.Label()
+        self._window_status.get_style_context().add_class("title-2")
+        box.pack_start(self._window_status, False, False, 0)
+        self._window_button = Gtk.Button()
+        self._window_button.set_halign(Gtk.Align.CENTER)
+        self._window_button.connect("clicked", self._on_window_button_clicked)
+        box.pack_start(self._window_button, False, False, 0)
+        hint = Gtk.Label(
+            label="Speech is typed into the focused window, so this window "
+            "minimizes when voice typing starts or stops.",
+            wrap=True,
+            max_width_chars=40,
+            justify=Gtk.Justification.CENTER,
+        )
+        hint.get_style_context().add_class("dim-label")
+        box.pack_start(hint, False, False, 0)
+        window.add(box)
+
+        self._window = window
+        window.show_all()
+
+    def _update_window(self, state: RecognitionState, transcribing: bool) -> None:
+        """Mirror the recognition state in the window, if there is one."""
+        if getattr(self, "_window", None) is None:
+            return
+        if state == RecognitionState.LISTENING:
+            icon, status = "active", "Listening"
+        elif state == RecognitionState.PROCESSING:
+            icon, status = "processing", "Transcribing" if transcribing else "Processing speech"
+        elif state == RecognitionState.ERROR:
+            icon, status = "default", "Error"
+        else:
+            icon, status = "default", "Not listening"
+        try:
+            self._window_image.set_from_pixbuf(
+                GdkPixbuf.Pixbuf.new_from_file_at_size(self.icon_paths[icon], 96, 96)
+            )
+        except GLib.Error:
+            self._window_image.set_from_icon_name("vocalinux", Gtk.IconSize.DIALOG)
+        self._window_status.set_text(status)
+        idle = state in (RecognitionState.IDLE, RecognitionState.ERROR)
+        self._window_button.set_label("Start Voice Typing" if idle else "Stop Voice Typing")
+        style = self._window_button.get_style_context()
+        style.remove_class("destructive-action" if idle else "suggested-action")
+        style.add_class("suggested-action" if idle else "destructive-action")
+
+    def _on_window_button_clicked(self, _button) -> None:
+        # Text goes to the focused window, which would be this one: minimize
+        # it, so focus goes back to the window the user was typing in
+        self._window.iconify()
+        if self.speech_engine.state in (RecognitionState.IDLE, RecognitionState.ERROR):
+            self._on_start_clicked(None)
+        else:
+            self._on_stop_clicked(None)
+
+    def _on_window_delete(self, _window, _event) -> bool:
+        self._quit()
+        return True
+
