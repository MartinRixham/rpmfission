[rpmfission]
name=rpmfission
baseurl=https://MartinRixham.github.io/rpmfission/fedora-$releasever-$basearch/
type=rpm-md
priority=90
metadata_expire=6h
skip_if_unavailable=True
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://MartinRixham.github.io/rpmfission/RPM-GPG-KEY-rpmfission
enabled=1
enabled_metadata=1
