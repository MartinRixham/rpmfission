From 486a1d4939bcf9dc3a0a3ba83c75e63e254d58bb Mon Sep 17 00:00:00 2001
From: Janne Grunau <j@jannau.net>
Date: Sat, 31 Oct 2026 16:32:00 +0100
Subject: [PATCH 2/3] build: use int as type for `pad` value

It'll be used for computation in meson.

Signed-off-by: Janne Grunau <j@jannau.net>
---
 meson.build | 14 +++++++-------
 1 file changed, 7 insertions(+), 7 deletions(-)

diff --git a/meson.build b/meson.build
index d2d9378..182a782 100644
--- a/meson.build
+++ b/meson.build
@@ -32,12 +32,12 @@ sources = files(['src/avd.c', 'src/config.c', 'src/irq.c', 'src/util.c'])
 ld_scripts = files('avd-cm3.ld')
 
 avd_variants = [
-    { 'name': 'avd-fw-v2-t0', 'version': '2', 'tier': '0', 'pad': '0xc000'},
-    { 'name': 'avd-fw-v3-t0', 'version': '3', 'tier': '0', 'pad': '0x10000'},
-    { 'name': 'avd-fw-v3-t1', 'version': '3', 'tier': '1', 'pad': '0x10000'},
-    { 'name': 'avd-fw-v4-t0', 'version': '4', 'tier': '0', 'pad': '0x12000'},
-    { 'name': 'avd-fw-v5-t0', 'version': '5', 'tier': '0', 'pad': '0x10000'},
-    { 'name': 'avd-fw-v5-t1', 'version': '5', 'tier': '1', 'pad': '0x12000'},
+    { 'name': 'avd-fw-v2-t0', 'version': '2', 'tier': '0', 'pad': 0xc000},
+    { 'name': 'avd-fw-v3-t0', 'version': '3', 'tier': '0', 'pad': 0x10000},
+    { 'name': 'avd-fw-v3-t1', 'version': '3', 'tier': '1', 'pad': 0x10000},
+    { 'name': 'avd-fw-v4-t0', 'version': '4', 'tier': '0', 'pad': 0x12000},
+    { 'name': 'avd-fw-v5-t0', 'version': '5', 'tier': '0', 'pad': 0x10000},
+    { 'name': 'avd-fw-v5-t1', 'version': '5', 'tier': '1', 'pad': 0x12000},
 ]
 
 conf_data = configuration_data()
@@ -77,7 +77,7 @@ foreach var : avd_variants
                     '-O',
                     'binary',
                     '--strip-debug',
-                    '--pad-to=' + var['pad'],
+                    '--pad-to=' + var['pad'].to_string(),
                     '@INPUT0@',
                     '@OUTPUT0@']
 
-- 
2.56.0

