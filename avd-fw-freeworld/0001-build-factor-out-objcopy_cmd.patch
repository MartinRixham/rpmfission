From 7116d36805651632a9adf59036b4ad694ecdfbd3 Mon Sep 17 00:00:00 2001
From: Janne Grunau <j@jannau.net>
Date: Sat, 31 Oct 2026 16:28:16 +0100
Subject: [PATCH 1/3] build: factor out `objcopy_cmd`

Signed-off-by: Janne Grunau <j@jannau.net>
---
 meson.build | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/meson.build b/meson.build
index 6a4f077..d2d9378 100644
--- a/meson.build
+++ b/meson.build
@@ -73,12 +73,20 @@ foreach var : avd_variants
         link_depends: ld_scripts,
     )
 
+    objcopy_cmd = [objcopy,
+                    '-O',
+                    'binary',
+                    '--strip-debug',
+                    '--pad-to=' + var['pad'],
+                    '@INPUT0@',
+                    '@OUTPUT0@']
+
     if meson.version().version_compare('>=1.10.0') == true
         custom_target(
             output: var['name'] + '.bin',
             build_subdir: 'apple',
             input: e,
-            command: [objcopy, '-O', 'binary',  '--strip-debug', '--pad-to=' + var['pad'], '@INPUT0@', '@OUTPUT0@'],
+            command: objcopy_cmd,
             install: true,
             install_dir: install_dir
         )
@@ -86,7 +94,7 @@ foreach var : avd_variants
         custom_target(
             output: var['name'] + '.bin',
             input: e,
-            command: [objcopy, '-O', 'binary',  '--strip-debug', '--pad-to=' + var['pad'], '@INPUT0@', '@OUTPUT0@'],
+            command: objcopy_cmd,
             install: true,
             install_dir: install_dir
         )
-- 
2.56.0

