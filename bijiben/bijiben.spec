# GNOME Notes, ported to GTK 4 and libadwaita in a fork of the archived
# upstream (https://gitlab.gnome.org/GNOME/gnome-notes). It replaces Fedora's
# bijiben 40.2, the GTK 3 release.
#
# The tarball is made from the release tag by sources.sh, since gitlab.gnome.org
# refuses archive downloads from spectool. Update both of these with Version;
# sources.sh reads them with sed, so keep them literal.
%global tag     BIJIBEN_41_0
%global commit  bae040ec9ff589b510bda2e0461fbc519689573f

Name:           bijiben
Version:        41.0
Release:        1%{?dist}
Summary:        Simple note editor

# Most of it is GPL-3.0-or-later; the list view and empty results box are
# GPL-2.0-or-later, the editor selection is LGPL v2 or v3, and the help is
# CC-BY-SA-3.0
License:        GPL-3.0-or-later AND GPL-2.0-or-later AND (LGPL-2.0-only OR LGPL-3.0-only) AND CC-BY-SA-3.0
URL:            https://gitlab.gnome.org/MartinRixham/gnome-notes
# Generated by sources.sh: git archive of %%{tag}
Source0:        %{name}-%{version}.tar.xz

BuildRequires:  gcc
BuildRequires:  meson >= 0.60.0
BuildRequires:  gettext
BuildRequires:  itstool
BuildRequires:  desktop-file-utils
BuildRequires:  libappstream-glib
BuildRequires:  pkgconfig(gio-unix-2.0)
BuildRequires:  pkgconfig(glib-2.0) >= 2.53.4
BuildRequires:  pkgconfig(goa-1.0)
BuildRequires:  pkgconfig(gtk4) >= 4.18
BuildRequires:  pkgconfig(json-glib-1.0)
BuildRequires:  pkgconfig(libadwaita-1) >= 1.6
BuildRequires:  pkgconfig(libcurl)
BuildRequires:  pkgconfig(libecal-2.0) >= 3.33.2
BuildRequires:  pkgconfig(libedataserver-1.2) >= 3.13.90
BuildRequires:  pkgconfig(libxml-2.0)
BuildRequires:  pkgconfig(tracker-sparql-3.0)
BuildRequires:  pkgconfig(uuid)
BuildRequires:  pkgconfig(webkitgtk-6.0) >= 2.44
# For the unit tests, which start evolution-data-server on a private bus
BuildRequires:  dbus-daemon
BuildRequires:  evolution-data-server
# The UI tests are built, since %%meson enables auto features, but not run
BuildRequires:  pkgconfig(libei-1.0)
BuildRequires:  pkgconfig(xkbcommon)

# Online accounts (Nextcloud notes) are reached through GVfs
Recommends:     gvfs-goa

%description
GNOME Notes (formerly Bijiben) is a simple note editor which puts the
emphasis on visuals: quickly write notes, and quickly find them back. Notes
are stored locally and can be imported from Tomboy and Gnote, and synced
through Nextcloud or Evolution memos.


%prep
%autosetup -p1


%build
# Notes are indexed in a private Tracker store, so the Tracker service is not
# needed
%meson -Dupdate_mimedb=false
%meson_build


%install
%meson_install
%find_lang %{name} --with-gnome


%check
appstream-util validate-relax --nonet %{buildroot}%{_metainfodir}/org.gnome.Notes.appdata.xml
desktop-file-validate %{buildroot}%{_datadir}/applications/org.gnome.Notes.desktop
# The UI tests drive the app in a headless mutter, which mock cannot run
%meson_test --suite unit


%files -f %{name}.lang
%license COPYING
%doc AUTHORS NEWS README.md
%{_bindir}/bijiben
%{_libexecdir}/bijiben-shell-search-provider
%{_datadir}/applications/org.gnome.Notes.desktop
%{_datadir}/bijiben/
%{_datadir}/dbus-1/services/org.gnome.Notes.SearchProvider.service
%{_datadir}/glib-2.0/schemas/org.gnome.Notes.gschema.xml
%dir %{_datadir}/gnome-shell
%dir %{_datadir}/gnome-shell/search-providers
%{_datadir}/gnome-shell/search-providers/org.gnome.Notes-search-provider.ini
%{_datadir}/icons/hicolor/scalable/apps/org.gnome.Notes.svg
%{_datadir}/icons/hicolor/symbolic/apps/org.gnome.Notes-symbolic.svg
%{_metainfodir}/org.gnome.Notes.appdata.xml
%{_datadir}/mime/packages/org.gnome.Notes.xml


%changelog
* Mon Nov 02 2026 Martin Rixham <martin.rixham@gmail.com> - 41.0-1
- Initial package, from the GTK 4 fork
