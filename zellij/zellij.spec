# Rust dependencies are vendored (see sources.sh), so the build runs offline
# as it would in COPR or mock.

Name:           zellij
Version:        0.45.1
Release:        3%{?dist}
Summary:        Terminal workspace with batteries included

# Zellij itself is MIT. The rest covers the bundled crates, as printed by
# %%cargo_license_summary in the build log; update it when bumping the version.
SourceLicense:  MIT
License:        MIT AND Apache-2.0 AND Apache-2.0 WITH LLVM-exception AND BSD-3-Clause AND 0BSD AND CC0-1.0 AND ISC AND MPL-2.0 AND Unicode-3.0 AND Zlib AND (Apache-2.0 OR MIT) AND (0BSD OR MIT OR Apache-2.0) AND (Apache-2.0 OR BSL-1.0) AND (Apache-2.0 OR ISC) AND (Apache-2.0 OR ISC OR MIT) AND (Apache-2.0 OR ISC OR MIT-0) AND (Apache-2.0 WITH LLVM-exception OR Apache-2.0 OR MIT) AND (BSD-2-Clause OR Apache-2.0 OR MIT) AND (CC0-1.0 OR MIT-0 OR Apache-2.0) AND (MIT OR Apache-2.0 OR LGPL-2.1-or-later) AND (MIT OR Zlib OR Apache-2.0) AND (Unlicense OR MIT)
URL:            https://zellij.dev
Source0:        https://github.com/zellij-org/zellij/archive/v%{version}/%{name}-%{version}.tar.gz
# Generated by sources.sh: `cargo vendor` of the tarball's Cargo.lock
Source1:        %{name}-%{version}-vendor.tar.xz
# Launches zellij in foot, replacing upstream's Terminal=true entry
Source2:        zellij.desktop
# The logo is taller than wide and has no viewBox, so icon renderers that
# scale it to a square squash the hexagon. Make the canvas square with the
# hexagon centred.
Patch0:         zellij-logo-viewbox.patch

ExclusiveArch:  %{rust_arches}

BuildRequires:  cargo-rpm-macros >= 26
BuildRequires:  rust-std-static-wasm32-wasip1
BuildRequires:  pkgconfig(libcurl)
BuildRequires:  pkgconfig(openssl)
BuildRequires:  pkgconfig(sqlite3)
BuildRequires:  pkgconfig(zlib)
BuildRequires:  desktop-file-utils

# Used by the desktop entry
Requires:       foot
Requires:       droid-sans-mono-nerd-fonts

%description
Zellij is a workspace aimed at developers, ops-oriented people and anyone who
loves the terminal. It is a terminal multiplexer with a plugin system that
lets you build your own layouts and tools in any language that compiles to
WebAssembly.

%prep
%autosetup -n %{name}-%{version} -p1 -a1
%cargo_prep -v vendor
# Use the system toolchain rather than the pinned rustup one
rm -f rust-toolchain.toml
# Rebuild the bundled plugins from source instead of shipping upstream's
# prebuilt WebAssembly binaries
rm -f zellij-utils/assets/plugins/*.wasm

%build
# The default plugins are compiled to WebAssembly and embedded in the binary.
# Fedora's RUSTFLAGS (exported by %%set_build_flags and %%__cargo) are for
# native ELF linking, so they are dropped for the wasm target.
plugins=""
for dir in default-plugins/*/; do
    plugins="$plugins -p $(basename "$dir")"
done
env -u RUSTFLAGS CARGO_HOME=.cargo %{_bindir}/cargo build --offline --release \
    --target wasm32-wasip1 $plugins
for dir in default-plugins/*/; do
    p=$(basename "$dir")
    cp -p target/wasm32-wasip1/release/$p.wasm zellij-utils/assets/plugins/
done

# vendored_curl is dropped from the defaults to link the system libcurl and
# openssl. rusqlite turns on libsqlite3-sys's bundled SQLite; the variable
# makes it link the system library instead, without editing Cargo.toml (which
# would change Cargo.lock).
export LIBSQLITE3_SYS_USE_PKG_CONFIG=1
%cargo_build -n -f web_server_capability
%{cargo_license_summary -n -f web_server_capability}
%{cargo_license -n -f web_server_capability} > LICENSE.dependencies
%cargo_vendor_manifest

for shell in bash fish zsh; do
    target/rpm/zellij setup --generate-completion $shell > completion.$shell
done

%install
install -Dpm 0755 target/rpm/zellij %{buildroot}%{_bindir}/zellij
install -Dpm 0644 completion.bash %{buildroot}%{bash_completions_dir}/zellij
install -Dpm 0644 completion.fish %{buildroot}%{fish_completions_dir}/zellij.fish
install -Dpm 0644 completion.zsh %{buildroot}%{zsh_completions_dir}/_zellij
install -Dpm 0644 assets/logo.svg %{buildroot}%{_datadir}/icons/hicolor/scalable/apps/zellij.svg
desktop-file-install --dir=%{buildroot}%{_datadir}/applications %{SOURCE2}

%check
desktop-file-validate %{buildroot}%{_datadir}/applications/zellij.desktop
%{buildroot}%{_bindir}/zellij --version

%files
%license LICENSE.md LICENSE.dependencies cargo-vendor.txt
%doc README.md CHANGELOG.md
%{_bindir}/zellij
%{bash_completions_dir}/zellij
%{fish_completions_dir}/zellij.fish
%{zsh_completions_dir}/_zellij
%{_datadir}/applications/zellij.desktop
%{_datadir}/icons/hicolor/scalable/apps/zellij.svg

